OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Supabase (Project settings > API). Leave empty to keep everything in this browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this one in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fitness bands (profile menu > Connect devices). Register an app with each company, then paste its keys here.
# Redirect URL to register: <your app address>/api/devices/<whoop|polar>/callback
APP_URL=
DEVICE_TOKEN_KEY=   # 64 hex characters, made with: openssl rand -hex 32
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
